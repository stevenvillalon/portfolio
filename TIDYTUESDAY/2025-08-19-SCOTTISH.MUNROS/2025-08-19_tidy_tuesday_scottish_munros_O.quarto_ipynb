       "1           17     Ben Vorlich     985.3     3233.0  262912.0  718916.0   \n",
       "2           18  Stuc a' Chroin     973.0     3192.0  261746.0  717465.0   \n",
       "3           32      Ben Lomond     973.7     3195.0  236707.0  702863.0   \n",
       "4           26        Ben More    1174.0     3852.0  243276.0  724417.0   \n",
       "\n",
       "  munro_type  \n",

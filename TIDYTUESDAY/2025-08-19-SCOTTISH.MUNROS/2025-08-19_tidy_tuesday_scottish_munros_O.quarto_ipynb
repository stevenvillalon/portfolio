   "source": [
    "---\n",
    "title: \"Scottish Munros\"\n",
    "subtitle: \"Scotland is a hiker's paradise.\"\n",
    "author: \"Steven Villalon\"\n",
    "date: 2025-08-19\n",
    "categories: [\"Maps\", \"Python\"]\n",
    "image: output/2025-08-19_tidy_tuesday_scottish_munros.png\n",
    "format:\n",

  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1989ddd4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data\n",
    "scottish_munros = pd.read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2025/2025-08-19/scottish_munros.csv',\n",
    "encoding=\"latin-1\")"

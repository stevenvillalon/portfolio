     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Remove unnecessary columns and limit to just 2021 data\n",
    "df = scottish_munros[['DoBIH_number', 'Name', 'Height_m', 'Height_ft', 'xcoord', 'ycoord', '2021']]\n",
    "\n",
    "# Rename 2021 column     \n",
    "df = df.rename(columns={\"2021\": \"munro_type\"})\n",
    "\n",
    "# Drop NAs and limit to Munros only\n",
    "df = df[df['munro_type'] == 'Munro'].dropna()\n",
    "\n",
    "# Reset index\n",
    "df = df.reset_index(drop=True)\n",
    "\n",
    "df.head()\n",
    "\n",
    "# Count NAs\n",
    "# df['munro_type'].isna().sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "a633d087",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert x/y to lat/lon\n",
    "# Set up transformer: OSGB36 (EPSG:27700) -> WGS84 lat/lon (EPSG:4326)\n",
    "transformer = Transformer.from_crs(\"epsg:27700\", \"epsg:4326\", always_xy=True)\n",
    "\n",
    "# Apply conversion\n",
    "df[\"lon\"], df[\"lat\"] = transformer.transform(df[\"xcoord\"].values, df[\"ycoord\"].values)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e057960a",
   "metadata": {},
   "source": [
    "## 5. Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "b7b1f624",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 768x768 with 1 Axes>"
      ]
     },
     "metadata": {
      "image/png": {
       "height": 793,
       "width": 583
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Set font\n",
    "plt.rcParams['font.family'] = 'Lato'\n",
    "\n",
    "# Load world data\n",
    "world = gpd.read_file('https://naciscdn.org/naturalearth/10m/cultural/ne_10m_admin_0_countries.zip')\n",
    "\n",
    "# Filter for UK\n",
    "uk = world[world['NAME'] == 'United Kingdom']\n",
    "\n",
    "# Create plot\n",
    "fig, ax = plt.subplots(figsize=(8, 8))\n",
    "\n",
    "# Set background color for water\n",
    "ax.set_facecolor('lightblue')\n",
    "\n",
    "# Plot UK map and set land color\n",
    "map_plot = uk.plot(ax=ax, color='beige', edgecolor='black', linewidth=0.5)\n",
    "\n",
    "# Plot munros as scatterplot\n",
    "scatter_plot = ax.scatter(df['lon'], df['lat'], c='forestgreen', s=25, alpha=0.8, edgecolors='black', linewidth=0.5, label='Munros')\n",
    "\n",
    "# Map boundary (Zoom in on Scotland)\n",
    "xlim = ax.set_xlim(-7.75, -1.75)\n",
    "ylim = ax.set_ylim(55.5, 59.5)\n",
    "\n",
    "# Labels\n",
    "main_title = plt.suptitle('Munros are primarily found along\\nScotland\\'s western Highlands', fontsize=24, fontweight='bold', y=0.98, ha='left', x=0.135)\n",
    "\n",
    "inset = plt.figtext(0.2, 0.75, 'A Munro is a\\nScottish mountain\\nwith an elevation\\nover 3,000 feet', \n",
    "                       fontsize=14, ha='left')\n",
    "\n",
    "country_name = plt.figtext(0.65, 0.41, 'SCOTLAND', \n",
    "                       fontsize=14, ha='left', color=\"darkgray\")                       \n",
    "\n",
    "caption = plt.figtext(0.135, -0.025, 'Source: The Database of British and Irish Hills v18.2\\nChart produced by Steven Villalon for Pydy Tuesday exercise on August 19, 2025.', fontsize=10, ha='left', alpha=0.7)\n",
    "\n",
    "ax.tick_params(left=False, bottom=False, labelleft=False, labelbottom=False)\n",
    "\n",
    "plt.tight_layout()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b1c19096",
   "metadata": {},
   "source": [
    "## 6. Export"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "4089e38b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save visualization as png\n",
    "fig.savefig(\"output/2025-08-19_tidy_tuesday_scottish_munros.png\",\n",
    "            dpi=300,\n",
    "            bbox_inches='tight',   \n",
    "            pad_inches=0.25        \n",
    "           )\n",
    "\n",
    "# Close the figure to free memory\n",
    "plt.close() "
   ]
  },

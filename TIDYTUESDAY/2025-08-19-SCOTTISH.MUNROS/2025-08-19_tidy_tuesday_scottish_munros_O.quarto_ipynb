   "metadata": {},
   "outputs": [],
   "source": [
    "# Load packages\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import warnings\n",
    "import session_info\n",
    "from pyproj import Transformer\n",
    "import geopandas as gpd"
   ]
  },
